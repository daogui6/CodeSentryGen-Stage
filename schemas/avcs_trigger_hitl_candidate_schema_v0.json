{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "avcs_trigger_hitl_candidate_schema_v0.json",
  "title": "CodeSentry-Gen AVCS HITL Trigger Candidate Schema v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_version",
    "case_id",
    "ecosystem",
    "distribution",
    "vulnerability",
    "evidence_sources",
    "proposal",
    "review_gate"
  ],
  "properties": {
    "schema_version": {
      "const": "avcs_trigger_hitl_candidate_v0.1"
    },
    "protocol_version": {
      "const": "avcs_trigger_eligibility_protocol_v0.2"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "ecosystem": {
      "type": "string",
      "minLength": 1
    },
    "distribution": {
      "type": "string",
      "minLength": 1
    },
    "vulnerability": {
      "$ref": "#/$defs/vulnerability"
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence_source"
      }
    },
    "proposal": {
      "$ref": "#/$defs/proposal"
    },
    "review_gate": {
      "$ref": "#/$defs/review_gate"
    }
  },
  "$defs": {
    "vulnerability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vulnerability_id",
        "aliases",
        "affected_version_scope",
        "fixed_versions",
        "source_refs"
      ],
      "properties": {
        "vulnerability_id": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "affected_version_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "fixed_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "type": [
            "string",
            "null"
          ]
        },
        "claim": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposer_type",
        "proposer_id",
        "proposed_status",
        "candidate_rule",
        "claim_evidence_map",
        "unresolved_questions"
      ],
      "properties": {
        "proposer_type": {
          "enum": [
            "llm",
            "automatic",
            "human_seeded"
          ]
        },
        "proposer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposed_status": {
          "enum": [
            "eligible",
            "unsupported_complex",
            "insufficient_evidence",
            "conflicted",
            "requires_review"
          ]
        },
        "candidate_rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/candidate_rule"
            },
            {
              "type": "null"
            }
          ]
        },
        "claim_evidence_map": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim_evidence"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "candidate_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_id",
        "vulnerability_ids",
        "api_symbol",
        "kind",
        "version_scope",
        "requires_untrusted_input",
        "conditions",
        "evidence_refs"
      ],
      "properties": {
        "trigger_id": {
          "type": "string",
          "minLength": 1
        },
        "vulnerability_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "api_symbol": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "direct_api",
            "keyword_literal_condition",
            "keyword_argument_condition",
            "keyword_call_condition",
            "omitted_keyword_historical_default",
            "positional_url_condition",
            "receiver_producer_keyword_literal_condition"
          ]
        },
        "version_scope": {
          "type": "string",
          "minLength": 1
        },
        "requires_untrusted_input": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "conditions": {
          "type": "object",
          "additionalProperties": true
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim",
        "evidence_refs"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "review_required",
        "final_truth_created",
        "reviewer",
        "reviewed_at"
      ],
      "properties": {
        "status": {
          "const": "requires_review"
        },
        "review_required": {
          "const": true
        },
        "final_truth_created": {
          "const": false
        },
        "reviewer": {
          "type": "null"
        },
        "reviewed_at": {
          "type": "null"
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
